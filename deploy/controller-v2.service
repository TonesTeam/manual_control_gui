[Unit]
Description=Tones controller_v2 protocol server
Documentation=https://github.com/TonesTeam/controller_v2
# controller_v2 looks for the RS485 (USB_Serial) and WeAct CAN adapters as it
# starts. When it finds both it opens them and queues its initialisation
# sequence, so the pumps and valves move at boot. Don't enable this together
# with tstand-server unless that is what you want: the two contend for the bus.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rpi
# Needed once it is initialised and opens the serial ports.
SupplementaryGroups=dialout
# Cross-compiled on the PC and uploaded by deploy/deploy.sh (make deploy).
WorkingDirectory=/home/rpi/tstand
ExecStart=/home/rpi/tstand/controller_v2

Restart=always
RestartSec=2

StandardOutput=journal
StandardError=journal
SyslogIdentifier=controller-v2

# It writes no files: serial ports, loopback HTTP and Moonraker on :7125.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
